<%- include ('./partials/secureHeader') %>	

        <!-- Page Content - Only Page Elements Here-->
        <div class="page-content footer-clear">

            <!-- Page Title-->
            <div class="pt-3">
                <div class="page-title d-flex">
                    <div class="align-self-center">
                        <a href="#"
                            data-back-button
                            class="me-3 ms-0 icon icon-xxs bg-theme rounded-s shadow-m">
                            <i class="bi bi-chevron-left color-theme font-14"></i>
                        </a>
                    </div>
                    <div class="align-self-center me-auto">
                        <h1 class="color-theme mb-0 font-18">Order Qphone</h1>
                    </div>
                    <div class="align-self-center ms-auto">
                        <a href="#" data-bs-toggle="offcanvas" data-bs-target="#menu-sidebar"
                            class="icon icon-xxs gradient-highlight color-white shadow-bg shadow-bg-xs rounded-s">
                            <i class="bi bi-list font-20"></i>
                        </a>
                    </div>
                </div>
            </div>

            <link rel="stylesheet" href="/card/style.css">
            <script src="/card/costom.js"></script>

            <div class="card card-style">
                <div class="content">

                    <div class="text-center">
                        <img src="/img/qq.jpg" class="img-fluid rounded-s">
                    </div>

                    <br>
                    <div class="col-12">
                        <a href="/secure/dashboard" class="w-100 btn-full btn gradient-green shadow-bg shadow-bg-m">Back to Dashboard</a>
                    </div>
                    <br>
                    <div>
                        <a class="btn btn-full bg-highlight btn-s font-11 text-uppercase rounded-xs shadow-m text-uppercase font-700" data-bs-toggle="collapse" href="#collapse1" aria-controls="collapse1">
                            Proceed
                        </a>
                    </div>

                    <div class="collapse" id="collapse1">
                        <div class="card card-style">
                            <div class="content">

                                <form id="qphoneform">

                                    <!-- Coin Selector -->
                                    <div class="form-custom form-label form-icon mb-3">
                                        <i class="bi bi-currency-bitcoin font-13"></i>
                                        <select name="wallet_address" required class="form-control" id="wallet_address">
                                            <option value="" disabled selected>Select a payment coin</option>
                                            <option value="0x1ebbf36b416EaB62458C9D9d3e6aa468993eb104" data-coin="Bitcoin (BTC)">Bitcoin (BTC)</option>
                                            <option value="0x1ebbf36b416EaB62458C9D9d3e6aa468993eb104" data-coin="Ethereum (ETH)">Ethereum (ETH)</option>
                                            <option value="8FerakH9Ln8c4b4VhZnY65fTrZFVpQJvFK7dCdG8easU" data-coin="BNB">BNB</option>
                                            <option value="qphpw6lsaqu9pnrv9ywyjnaksdzp0t2tpcm7ahvxj5" data-coin="Solana (SOL)">Solana (SOL)</option>
                                            <option value="qphpw6lsaqu9pnrv9ywyjnaksdzp0t2tpcm7ahvxj" data-coin="Bitcoin Cash (BCH)">Bitcoin Cash (BCH)</option>
                                            <option value="0x1ebbf36b416EaB62458C9D9d3e6aa468993eb104" data-coin="Polygon (POL)">Polygon (POL)</option>
                                            <option value="ltc1q5m0ujyjmafkch2w6dpzfnvmskn424wj5ezt5st" data-coin="Litecoin (LTC)">Litecoin (LTC)</option>
                                            <option value="1oysEGWgciTQTJ6m9fik79qCsoB1vVtvpk3CGrNtU1LCFJP" data-coin="Avalanche (AVAX)">Avalanche (AVAX)</option>
                                            <option value="0x1ebbf36b416EaB62458C9D9d3e6aa468993eb104" data-coin="Polkadot (DOT)">Polkadot (DOT)</option>
                                            <option value="0x1ebbf36b416EaB62458C9D9d3e6aa468993eb104" data-coin="Gold (GOLD)">Gold (GOLD)</option>
                                            <option value="UQDIVMGhsPbmdaw6zBmlx6aXYpjgZ_CEB8yVUHsvIEk7iHlJ" data-coin="Toncoin (TON)">Toncoin (TON)</option>
                                            <option value="DMkq9FJwM5FBGwASFjtqockyxV33n2QhER" data-coin="Silver (SILVER)">Silver (SILVER)</option>
                                            <option value="DMkq9FJwM5FBGwASFjtqockyxV33n2QhER" data-coin="Dogecoin (DOGE)">Dogecoin (DOGE)</option>
                                            <option value="addr1qynfqxw3hku72h9k0jfhw5zjgrga79dwf93g4kmfcnyfn0fps4z3w8kj3qny5g3g47anrmjhc7a9l6ckuejmdnnqtd2q03gadm" data-coin="Cardano (ADA)">Cardano (ADA)</option>
                                            <option value="GBCECILVV2OVUDJ4HJ2OTZPAWOTNWXN5N35T5GAQQENMLSQVTFM5F27Q" data-coin="Stellar (XLM)">Stellar (XLM)</option>
                                            <option value="0x0c159ebbfb9af39d37712cc75f7d205acf616db6f253c54cb76ee3ebd30bbf84" data-coin="Sui (SUI)">Sui (SUI)</option>
                                            <option value="rPKkEPCD2HYxowMYShcfZpU5Hpkcbbm4Ez" data-coin="Ripple (XRP)">Ripple (XRP)</option>
                                        </select>
                                        <label for="wallet_address" class="color-highlight form-label-always-active">Select Payment Coin</label>
                                    </div>

                                    <!-- Address Display Box (hidden until coin selected) -->
                                    <div id="addressBox" style="display: none;" class="mb-3">
                                        <div style="
                                            background: #f8f9fa;
                                            border: 1px solid #dee2e6;
                                            border-radius: 10px;
                                            padding: 14px 16px;
                                        ">
                                            <p class="font-12 opacity-60 mb-1">Send <strong id="selectedCoinName"></strong> to this address:</p>
                                            <div style="display: flex; align-items: center; gap: 10px;">
                                                <p id="displayAddress" style="
                                                    font-size: 13px;
                                                    word-break: break-all;
                                                    margin: 0;
                                                    flex: 1;
                                                    font-weight: 500;
                                                "></p>
                                                <button type="button" id="copyBtn" onclick="copyAddress()" style="
                                                    background: linear-gradient(135deg, #667eea, #764ba2);
                                                    color: white;
                                                    border: none;
                                                    border-radius: 8px;
                                                    padding: 8px 14px;
                                                    font-size: 12px;
                                                    cursor: pointer;
                                                    white-space: nowrap;
                                                ">
                                                    <i class="bi bi-copy"></i> Copy
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Amount -->
                                    <div class="col-12">
                                        <div class="form-custom form-label mb-3 form-icon">
                                            <i class="bi bi-cash font-14"></i>
                                            <input name="amount" type="number" class="form-control rounded-xs" id="amount" value="5000" readonly />
                                            <label for="amount" class="color-highlight form-label-always-active">Amount</label>
                                        </div>
                                    </div>

                                    <div class="divider mt-2 mb-4"></div>
                                    <h4 style="margin-bottom: 17px;">Your Details</h4>
                                    <div class="divider mt-2 mb-4"></div>

                                    <!-- Full Name -->
                                    <div class="form-custom form-label form-icon mb-3 mt-3">
                                        <i class="bi bi-person-circle font-14"></i>
                                        <input type="text" name="fullname" class="form-control rounded-xs" id="cardholdersname" placeholder="John Doe" />
                                        <label for="cardholdersname" class="color-highlight form-label-always-active">Full Name</label>
                                    </div>

                                    <!-- Email -->
                                    <div class="col-12">
                                        <div class="form-custom form-label mb-3 form-icon">
                                            <i class="bi bi-envelope-open-fill font-14"></i>
                                            <input name="email" type="email" class="form-control rounded-xs" id="email" placeholder="doe@gmail.com" />
                                            <label for="email" class="color-highlight form-label-always-active">Email</label>
                                        </div>
                                    </div>

                                    <!-- Phone -->
                                    <div class="col-12">
                                        <div class="form-custom form-label mb-3 form-icon">
                                            <i class="bi bi-telephone-fill font-14"></i>
                                            <input name="phone" type="tel" class="form-control rounded-xs" id="phone" placeholder="+1 234 567 809" />
                                            <label for="phone" class="color-highlight form-label-always-active">Phone Number</label>
                                        </div>
                                    </div>

                                    <!-- Address -->
                                    <div class="col-12">
                                        <div class="form-custom form-label mb-3 form-icon">
                                            <i class="bi bi-geo-alt-fill font-12"></i>
                                            <textarea name="address" class="form-control rounded-xs" placeholder="Detail your address" id="address"></textarea>
                                            <label for="address" class="form-label-always-active color-highlight font-11">Delivery Address</label>
                                        </div>
                                    </div>

                                    <!-- Proof of Payment -->
                                    <div class="file-data">
                                        <div class="form-custom form-label mb-3 form-icon">
                                            <input type="file" id="Poof_of_payment" name="Poof_of_payment" class="dropify" data-height="50" data-default-file="" />
                                            <label for="Poof_of_payment" class="color-highlight form-label-always-active">Attach Proof Of Payment</label>
                                        </div>
                                    </div>

                                    <a href="#" id="qphonebtn" class="btn btn-full gradient-highlight shadow-bg shadow-bg-s">Pre-Order</a>

                                </form>

                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>

    </div>
    <!-- End of Page ID-->

    <script src="/scripts/bootstrap.min.js"></script>
    <script src="/scripts/custom.js"></script>
</body>

<script>
    // Show address when coin is selected
    $('#wallet_address').on('change', function() {
        const address = $(this).val();
        const coinName = $(this).find('option:selected').data('coin');

        if (address) {
            $('#displayAddress').text(address);
            $('#selectedCoinName').text(coinName);
            $('#addressBox').show();
        } else {
            $('#addressBox').hide();
        }
    });

    // Copy address to clipboard
    function copyAddress() {
        const address = document.getElementById('displayAddress').textContent;
        navigator.clipboard.writeText(address).then(() => {
            const btn = document.getElementById('copyBtn');
            btn.innerHTML = '<i class="bi bi-check2"></i> Copied!';
            btn.style.background = 'linear-gradient(135deg, #28a745, #20c997)';
            setTimeout(() => {
                btn.innerHTML = '<i class="bi bi-copy"></i> Copy';
                btn.style.background = 'linear-gradient(135deg, #667eea, #764ba2)';
            }, 2000);
        }).catch(() => {
            // Fallback for older browsers
            const el = document.createElement('textarea');
            el.value = address;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);
            toastr["success"]("Address copied!");
        });
    }

    // Form submission
    $(document).on("click", "#qphonebtn", function(e) {
        e.preventDefault();

        $(this).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing, please wait...')
            .css("pointer-events", "none");

        // Basic validation
        const requiredFields = ['wallet_address', 'amount', 'cardholdersname', 'email', 'phone', 'address'];
        let isValid = true;

        requiredFields.forEach(id => {
            const el = document.getElementById(id);
            if (!el || !el.value.trim()) {
                isValid = false;
                if (el) el.classList.add('is-invalid');
            } else {
                if (el) el.classList.remove('is-invalid');
            }
        });

        // Check proof of payment file
        const fileInput = document.getElementById('Poof_of_payment');
        const dropifyWrapper = fileInput ? fileInput.closest('.dropify-wrapper') : null;
        const hasFile = dropifyWrapper
            ? dropifyWrapper.querySelector('.dropify-preview .dropify-render img') !== null
            : (fileInput && fileInput.files && fileInput.files.length > 0);

        if (!hasFile) {
            isValid = false;
            toastr["warning"]("Please attach your proof of payment.");
        }

        if (!isValid) {
            toastr["warning"]("Please fill in all required fields.");
            $('#qphonebtn').html('Pre-Order').css("pointer-events", "auto");
            return;
        }

        var formData = new FormData(document.getElementById("qphoneform"));

        $.ajax({
            url: '/secure/phone',
            type: 'POST',
            data: formData,
            contentType: false,
            cache: false,
            dataType: 'json',
            processData: false,
            success: function(response) {
                if (response.mssg === "ok") {
                    toastr["success"]("Your QPhone order has been submitted! We will verify your payment and process your shipment.");
                    $('#qphonebtn').html('Pre-Order').css("pointer-events", "auto");
                    $('#qphoneform')[0].reset();
                    $('#addressBox').hide();
                } else {
                    toastr["error"](response.mssg);
                    $('#qphonebtn').html('Pre-Order').css("pointer-events", "auto");
                }
            },
            error: function(xhr) {
                console.error('Error:', xhr.responseText);
                toastr["error"]("Something went wrong. Please try again.");
                $('#qphonebtn').html('Pre-Order').css("pointer-events", "auto");
            }
        });
    });
</script>