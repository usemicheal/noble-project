<%- include ('./partials/secureHeader') %>

        <div class="page-content footer-clear">

            <!-- Page Title -->
            <div class="pt-3">
                <div class="page-title d-flex">
                    <div class="align-self-center">
                        <a href="#" data-back-button class="me-3 ms-0 icon icon-xxs bg-theme rounded-s shadow-m">
                            <i class="bi bi-chevron-left color-theme font-14"></i>
                        </a>
                    </div>
                    <div class="align-self-center me-auto">
                        <h1 style="margin-top: 25px;" class="font-24">MEDBED QUANTUM APPOINTMENT BOOKING</h1>
                    </div>
                    <div class="align-self-center ms-auto">
                        <a href="#" data-bs-toggle="dropdown" class="icon gradient-blue shadow-bg shadow-bg-s rounded-m">
                            <img src="<%= currentUser?.image ? currentUser.image : '/img/user-default.png' %>" width="45" class="rounded-m" alt="img">
                        </a>
                        <div class="dropdown-menu">
                            <div class="card card-style shadow-m mt-1 me-1">
                                <div class="list-group list-custom list-group-s list-group-flush rounded-xs px-3 py-1">
                                    <a href="/secure/profile" class="list-group-item no-ajax" onclick="window.location=this.href; return false;">
                                        <i class="has-bg gradient-yellow shadow-bg shadow-bg-xs color-white rounded-xs bi bi-person-circle"></i>
                                        <strong class="font-13">Account</strong>
                                    </a>
                                    <a href="#" class="list-group-item" data-toggle-theme="" data-trigger-switch="switch-1">
                                        <i class="has-bg gradient-blue shadow-bg shadow-bg-xs color-white rounded-xs bi-lightbulb-fill"></i>
                                        <strong class="font-13">Dark Mood</strong>
                                        <div class="form-switch ios-switch switch-green switch-s me-2">
                                            <input type="checkbox" data-toggle-theme="" class="ios-input" id="switch-1">
                                            <label class="custom-control-label" for="switch-1"></label>
                                        </div>
                                    </a>
                                    <a href="/auth/logout" class="list-group-item no-ajax" onclick="window.location=this.href; return false;">
                                        <i class="has-bg gradient-red shadow-bg shadow-bg-xs color-white rounded-xs bi bi-power"></i>
                                        <strong class="font-13">Log Out</strong>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card card-style">
                <div class="content">

                    <% if (!appointment) { %>
                    <!-- STATE 0: No application yet — show booking form -->
                    <h4 class="mb-1">Book Your MedBed Quantum Appointment</h4>
                    <p class="font-13 opacity-70 mb-4">
                        Fill in your details below to submit your appointment application.
                        Our team will review it and notify you by email once approved.
                    </p>

                    <form id="booking_form">
                        <div class="form-custom form-label form-icon mb-3 mt-3">
                            <i class="bi bi-person-circle font-14"></i>
                            <input name="sender_name" type="text" class="form-control rounded-xs"
                                   value="<%= currentUser?.fullname %>" readonly id="c1" placeholder="John Doe" />
                            <label for="c1" class="color-highlight form-label-always-active">Full Name</label>
                        </div>

                        <div class="form-custom form-label form-icon mb-3">
                            <i class="bi bi-exclamation-circle font-14"></i>
                            <input type="text" name="sender_subject" class="form-control rounded-xs" id="c2" />
                            <label for="c2" class="color-highlight form-label-always-active">Subject</label>
                        </div>

                        <div class="form-custom form-label form-icon mb-3">
                            <i class="bi bi-envelope-at font-14"></i>
                            <input type="email" name="sender_email" class="form-control rounded-xs" id="c3"
                                   value="<%= currentUser?.email %>" readonly placeholder="Your Email" />
                            <label for="c3" class="color-highlight form-label-always-active">Email Address</label>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="form-group form-label mb-3">
                                    <textarea style="border-radius:8px;background:transparent;"
                                              placeholder="Describe your medical needs or reason for booking"
                                              name="sender_mssg" class="form-control" rows="4" required></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="divider mt-2 mb-4"></div>
                        <a href="#" id="submit_booking" class="btn btn-full gradient-highlight shadow-bg shadow-bg-s">
                            Submit Application
                        </a>
                    </form>

                    <% } else if (appointment.status === 'pending') { %>
                    <!-- STATE 1: Pending admin review -->
                    <div class="text-center py-4">
                        <i class="bi bi-hourglass-split font-50 color-yellow-dark"></i>
                        <h4 class="mt-3 mb-2">Application Under Review</h4>
                        <p class="font-13 opacity-70 mb-3">
                            Your MedBed Quantum appointment application has been received and is currently
                            being reviewed by our team. You will receive an email notification once a decision has been made.
                        </p>
                        <div style="background:#fff8e1;border:1px solid #ffe082;border-radius:10px;padding:14px 16px;">
                            <p class="font-12 mb-1"><strong>Subject:</strong> <%= appointment.sender_subject %></p>
                            <p class="font-12 mb-0 opacity-70">Submitted on <%= new Date(appointment.createdAt).toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' }) %></p>
                        </div>
                    </div>

                    <% } else if (appointment.status === 'rejected') { %>
                    <!-- STATE 2: Rejected -->
                    <div class="text-center py-4">
                        <i class="bi bi-x-circle font-50 color-red-dark"></i>
                        <h4 class="mt-3 mb-2">Application Not Approved</h4>
                        <p class="font-13 opacity-70 mb-4">
                            Unfortunately, your MedBed Quantum appointment application was not approved at this time.
                            Please contact our support team for more information.
                        </p>
                    </div>

                    <% } else if (appointment.isApproved && appointment.payment_status === 'submitted') { %>
                    <!-- STATE 3: Payment proof submitted, awaiting confirmation -->
                    <div class="text-center py-4">
                        <i class="bi bi-clock-history font-50 color-blue-dark"></i>
                        <h4 class="mt-3 mb-2">Payment Under Review</h4>
                        <p class="font-13 opacity-70 mb-3">
                            Your proof of payment has been received and is being reviewed by our team.
                            We will confirm your appointment shortly.
                        </p>
                        <div style="background:#e3f2fd;border:1px solid #90caf9;border-radius:10px;padding:14px 16px;">
                            <p class="font-12 mb-1"><strong>Amount Submitted:</strong> $<%= appointment.booking_amount?.toLocaleString() %></p>
                            <p class="font-12 mb-0 opacity-70">Payment proof uploaded successfully</p>
                        </div>
                    </div>

                    <% } else if (appointment.isApproved && appointment.payment_status === 'confirmed') { %>
                    <!-- STATE 4: Fully confirmed -->
                    <div class="text-center py-4">
                        <i class="bi bi-check-circle font-50 color-green-dark"></i>
                        <h4 class="mt-3 mb-2">Appointment Confirmed!</h4>
                        <p class="font-13 opacity-70 mb-3">
                            Your MedBed Quantum appointment has been fully confirmed. Our team will
                            be in touch with you shortly with the next steps.
                        </p>
                    </div>

                    <% } else if (appointment.isApproved && appointment.payment_status === 'unpaid') { %>
                    <!-- STATE 5: Approved — show payment addresses + admin-set amount -->

                    <!-- Approval notice -->
                    <div style="background:#e8f5e9;border:1px solid #a5d6a7;border-radius:10px;padding:14px 16px;margin-bottom:16px;">
                        <div class="d-flex align-items-center mb-1">
                            <i class="bi bi-check-circle-fill me-2" style="color:#2e7d32;font-size:16px;"></i>
                            <strong class="font-13" style="color:#2e7d32;">Your application has been approved!</strong>
                        </div>
                        <p class="font-12 mb-0 opacity-70">
                            Please send the exact amount below to any of the payment addresses, then attach your proof of payment.
                        </p>
                    </div>

                    <!-- Admin-set amount display -->
                    <div style="background:#f0fdf4;border:2px solid #86efac;border-radius:10px;padding:16px;margin-bottom:24px;text-align:center;">
                        <p class="font-12 mb-1" style="color:#166534;">Your required payment amount is:</p>
                        <p style="font-size:28px;font-weight:bold;color:#15803d;margin:4px 0 0;">
                            $<%= Number(appointment.booking_amount).toLocaleString() %>
                        </p>
                    </div>

                    <h4 class="mb-3">Step 1: Send Payment</h4>
                    <p class="font-13 opacity-70 mb-3">
                        Send the exact amount above to any of the addresses below.
                    </p>

                    <!-- USDT -->
                    <div style="background:#f8f9fa;border:1px solid #dee2e6;border-radius:10px;padding:14px 16px;margin-bottom:12px;">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                            <span class="font-12 font-700" style="color:#26a17b;">● USDT (TRC20)</span>
                            <button type="button" onclick="copyAddr('usdt_addr', this)" style="background:linear-gradient(135deg,#667eea,#764ba2);color:white;border:none;border-radius:8px;padding:6px 12px;font-size:11px;cursor:pointer;">
                                <i class="bi bi-copy"></i> Copy
                            </button>
                        </div>
                        <p id="usdt_addr" style="font-size:12px;word-break:break-all;margin:0;font-weight:500;">0xddda59E8E1cEC62c4E7208b3449AC0d52B46B489</p>
                    </div>

                    <!-- BTC -->
                    <div style="background:#f8f9fa;border:1px solid #dee2e6;border-radius:10px;padding:14px 16px;margin-bottom:12px;">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                            <span class="font-12 font-700" style="color:#f7931a;">● Bitcoin (BTC)</span>
                            <button type="button" onclick="copyAddr('btc_addr', this)" style="background:linear-gradient(135deg,#667eea,#764ba2);color:white;border:none;border-radius:8px;padding:6px 12px;font-size:11px;cursor:pointer;">
                                <i class="bi bi-copy"></i> Copy
                            </button>
                        </div>
                        <p id="btc_addr" style="font-size:12px;word-break:break-all;margin:0;font-weight:500;">bc1qsxqug9uzudp7n5xsgmry7ayu05h00mpp5vvsfs</p>
                    </div>

                    <!-- ETH -->
                    <div style="background:#f8f9fa;border:1px solid #dee2e6;border-radius:10px;padding:14px 16px;margin-bottom:12px;">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                            <span class="font-12 font-700" style="color:#627eea;">● Ethereum (ETH)</span>
                            <button type="button" onclick="copyAddr('eth_addr', this)" style="background:linear-gradient(135deg,#667eea,#764ba2);color:white;border:none;border-radius:8px;padding:6px 12px;font-size:11px;cursor:pointer;">
                                <i class="bi bi-copy"></i> Copy
                            </button>
                        </div>
                        <p id="eth_addr" style="font-size:12px;word-break:break-all;margin:0;font-weight:500;">0xddda59E8E1cEC62c4E7208b3449AC0d52B46B489</p>
                    </div>

                    <!-- XRP -->
                    <div style="background:#f8f9fa;border:1px solid #dee2e6;border-radius:10px;padding:14px 16px;margin-bottom:24px;">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                            <span class="font-12 font-700" style="color:#346aa9;">● Ripple (XRP)</span>
                            <button type="button" onclick="copyAddr('xrp_addr', this)" style="background:linear-gradient(135deg,#667eea,#764ba2);color:white;border:none;border-radius:8px;padding:6px 12px;font-size:11px;cursor:pointer;">
                                <i class="bi bi-copy"></i> Copy
                            </button>
                        </div>
                        <p id="xrp_addr" style="font-size:12px;word-break:break-all;margin:0;font-weight:500;">rNzmae7pVd1ybsjbYW92yWBo1orqj6QjVE</p>
                    </div>

                    <div class="divider mt-0 mb-4"></div>

                    <h4 class="mb-1">Step 2: Upload Proof of Payment</h4>
                    <p class="font-13 opacity-70 mb-4">Attach your payment receipt or screenshot below.</p>

                    <form id="payment_form">
                        <!-- Hidden amount — set by admin, not editable by user -->
                        <input type="hidden" name="booking_amount" value="<%= appointment.booking_amount %>" />

                        <!-- Proof of Payment -->
                        <div class="file-data mb-3">
                            <div class="form-custom form-label form-icon">
                                <input type="file" id="proof_of_payment" name="proof_of_payment"
                                       class="dropify" data-height="50" data-default-file="" />
                                <label for="proof_of_payment" class="color-highlight form-label-always-active">
                                    Attach Proof Of Payment
                                </label>
                            </div>
                        </div>

                        <div class="divider mt-2 mb-4"></div>
                        <a href="#" id="submit_payment" class="btn btn-full gradient-highlight shadow-bg shadow-bg-s">
                            Submit Payment Proof
                        </a>
                    </form>

                    <% } %>

                </div>
            </div>

        </div>
    </div>

<script>
    function copyAddr(elemId, btn) {
        const address = document.getElementById(elemId).textContent;
        navigator.clipboard.writeText(address).then(() => {
            btn.innerHTML = '<i class="bi bi-check2"></i> Copied!';
            btn.style.background = 'linear-gradient(135deg,#28a745,#20c997)';
            setTimeout(() => {
                btn.innerHTML = '<i class="bi bi-copy"></i> Copy';
                btn.style.background = 'linear-gradient(135deg,#667eea,#764ba2)';
            }, 2000);
        }).catch(() => {
            const el = document.createElement('textarea');
            el.value = address;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);
            toastr["success"]("Address copied!");
        });
    }

    // Stage 1: Submit booking application
    $(document).on("click", "#submit_booking", function(e) {
        e.preventDefault();
        $(this).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...').css("pointer-events", "none");

        var isValid = true;
        $("#booking_form input:not([readonly]), #booking_form textarea").each(function() {
            if (!$(this).val()) { $(this).addClass("is-invalid"); isValid = false; }
            else { $(this).removeClass("is-invalid"); }
        });

        if (!isValid) {
            toastr["warning"]("Please fill in all required fields.");
            $('#submit_booking').html('Submit Application').css("pointer-events", "auto");
            return;
        }

        $.ajax({
            url: '/secure/contact-medbed',
            type: 'POST',
            data: new FormData(document.getElementById("booking_form")),
            contentType: false, cache: false, dataType: 'json', processData: false,
            success: function(response) {
                if (response.mssg === "ok") {
                    Swal.fire({
                        icon: "success",
                        title: "Application Submitted!",
                        text: "Your application has been submitted. We will review it and notify you by email.",
                    }).then(() => location.reload());
                } else {
                    Swal.fire({ icon: "error", title: "Oops...", text: response.mssg });
                    $('#submit_booking').html('Submit Application').css("pointer-events", "auto");
                }
            },
            error: function() {
                toastr["error"]("Something went wrong. Please try again.");
                $('#submit_booking').html('Submit Application').css("pointer-events", "auto");
            }
        });
    });

    // Stage 2: Submit payment proof
    $(document).on("click", "#submit_payment", function(e) {
        e.preventDefault();
        $(this).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...').css("pointer-events", "none");

        // Validate proof of payment file
        const fileInput = document.getElementById('proof_of_payment');
        const dropifyWrapper = fileInput ? fileInput.closest('.dropify-wrapper') : null;
        const hasFile = dropifyWrapper
            ? dropifyWrapper.querySelector('.dropify-preview .dropify-render img') !== null
            : (fileInput && fileInput.files && fileInput.files.length > 0);

        if (!hasFile) {
            toastr["warning"]("Please attach your proof of payment.");
            $('#submit_payment').html('Submit Payment Proof').css("pointer-events", "auto");
            return;
        }

        $.ajax({
            url: '/secure/contact-medbed-payment',
            type: 'POST',
            data: new FormData(document.getElementById("payment_form")),
            contentType: false, cache: false, dataType: 'json', processData: false,
            success: function(response) {
                if (response.mssg === "ok") {
                    Swal.fire({
                        icon: "success",
                        title: "Payment Submitted!",
                        text: "Your proof of payment has been submitted. We will confirm your appointment shortly.",
                    }).then(() => location.reload());
                } else {
                    Swal.fire({ icon: "error", title: "Oops...", text: response.mssg });
                    $('#submit_payment').html('Submit Payment Proof').css("pointer-events", "auto");
                }
            },
            error: function() {
                toastr["error"]("Something went wrong. Please try again.");
                $('#submit_payment').html('Submit Payment Proof').css("pointer-events", "auto");
            }
        });
    });
</script>

<script src="/scripts/bootstrap.min.js"></script>
<script src="/scripts/custom.js"></script>