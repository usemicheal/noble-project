<%- include('../partials/header', { title: 'Appointment - Admin Dashboard' }) %>
<%- include('../partials/nav', { page: 'appointment' }) %>
<%- include('../partials/toast') %>

<div class="bg-white rounded-lg shadow overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead class="bg-gray-100">
        <tr>
          <th class="px-4 py-3 text-left text-sm font-medium">Sender</th>
          <th class="px-4 py-3 text-left text-sm font-medium">Subject</th>
          <th class="px-4 py-3 text-left text-sm font-medium">Application</th>
          <th class="px-4 py-3 text-left text-sm font-medium">Payment</th>
          <th class="px-4 py-3 text-left text-sm font-medium">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% if (appointment.length === 0) { %>
        <tr>
          <td colspan="5" class="px-4 py-6 text-center text-gray-400 text-sm">No appointments yet.</td>
        </tr>
        <% } %>
        <% appointment.forEach(app => { %>
        <tr>
          <td class="px-4 py-3 text-sm">
            <div class="font-bold"><%= app.sender_name %></div>
            <div class="text-xs text-gray-500"><%= app.sender_email %></div>
          </td>
          <td class="px-4 py-3 text-sm"><%= app.sender_subject %></td>
          <td class="px-4 py-3 text-sm">
            <% if (app.status === 'approved') { %>
              <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">Approved</span>
            <% } else if (app.status === 'rejected') { %>
              <span class="px-2 py-1 bg-red-100 text-red-700 rounded-full text-xs font-medium">Rejected</span>
            <% } else { %>
              <span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-medium">Pending</span>
            <% } %>
          </td>
          <td class="px-4 py-3 text-sm">
            <% if (app.payment_status === 'confirmed') { %>
              <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">Confirmed</span>
            <% } else if (app.payment_status === 'submitted') { %>
              <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-medium">Proof Submitted</span>
            <% } else { %>
              <span class="px-2 py-1 bg-gray-100 text-gray-500 rounded-full text-xs font-medium">Unpaid</span>
            <% } %>
          </td>
          <td class="px-4 py-3 text-sm">
            <button onclick="showAppModal('<%= app._id %>')" class="px-3 py-1 bg-gray-100 hover:bg-gray-200 rounded text-black text-xs">
              View Details
            </button>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<!-- APPOINTMENT DETAIL MODAL -->
<div id="appModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
  <div class="bg-white rounded-lg max-w-lg w-full max-h-screen overflow-y-auto shadow-xl">
    <div class="p-6">
      <div class="flex justify-between items-center mb-4 border-b pb-2">
        <h2 class="text-xl font-bold">Appointment Details</h2>
        <button onclick="closeModal()" class="text-2xl text-gray-400 hover:text-black">&times;</button>
      </div>

      <div id="modalContent" class="space-y-4"></div>

      <!-- Amount input — only shown when pending -->
      <div id="amountInputSection" class="hidden mt-4 p-4 bg-gray-50 rounded-lg border">
        <label class="block text-sm font-semibold mb-1 text-gray-700">
          💵 Set Payment Amount for User (USD)
        </label>
        <p class="text-xs text-gray-400 mb-2">This amount will be shown to the user on their booking page after approval.</p>
        <div class="flex gap-2 items-center">
          <span class="text-gray-500 font-bold">$</span>
          <input
            id="approvalAmountInput"
            type="number"
            min="1"
            placeholder="e.g. 25000"
            class="flex-1 border px-3 py-2 rounded text-sm focus:outline-none focus:ring-2 focus:ring-green-400"
          />
        </div>
      </div>

      <div class="flex flex-wrap gap-3 mt-6 border-t pt-4">
        <button id="approveBtn" class="hidden flex-1 px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 transition text-sm font-medium">
          ✅ Approve & Set Amount
        </button>
        <button id="rejectBtn" class="hidden px-4 py-2 bg-orange-500 text-white rounded hover:bg-orange-600 transition text-sm font-medium">
          ✕ Reject
        </button>
        <button id="confirmPaymentBtn" class="hidden flex-1 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition text-sm font-medium">
          💳 Confirm Payment
        </button>
        <button id="deleteBtn" class="px-4 py-2 bg-red-50 text-red-600 rounded hover:bg-red-100 transition text-sm">
          🗑 Delete
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const appointments = <%- JSON.stringify(appointment) %>;
  let currentAppId = null;

  function showAppModal(appId) {
    const app = appointments.find(a => a._id === appId);
    if (!app) return;
    currentAppId = appId;

    // Reset buttons and amount section
    document.getElementById('approveBtn').classList.add('hidden');
    document.getElementById('rejectBtn').classList.add('hidden');
    document.getElementById('confirmPaymentBtn').classList.add('hidden');
    document.getElementById('amountInputSection').classList.add('hidden');
    document.getElementById('approvalAmountInput').value = '';

    const proofHtml = app.proof_of_payment
      ? `<div class="mt-4">
           <div class="text-gray-500 text-sm mb-2 font-medium">Proof of Payment:</div>
           <img src="${app.proof_of_payment}" alt="Proof" class="w-full rounded-lg border" style="max-height:300px;object-fit:contain;">
         </div>`
      : `<div class="mt-4 p-3 bg-gray-50 rounded text-sm text-gray-400 text-center border">No proof of payment uploaded yet.</div>`;

    const statusLabels = {
      pending:  '<span class="px-2 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-medium">⏳ Pending Review</span>',
      approved: '<span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">✅ Approved</span>',
      rejected: '<span class="px-2 py-1 bg-red-100 text-red-700 rounded-full text-xs font-medium">✕ Rejected</span>',
    };
    const paymentLabels = {
      unpaid:    '<span class="px-2 py-1 bg-gray-100 text-gray-500 rounded-full text-xs">Awaiting Payment</span>',
      submitted: '<span class="px-2 py-1 bg-blue-100 text-blue-700 rounded-full text-xs">Proof Submitted</span>',
      confirmed: '<span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs">Payment Confirmed</span>',
    };

    const amountHtml = app.booking_amount
      ? `<div class="font-bold text-green-600">$${Number(app.booking_amount).toLocaleString()}</div>`
      : `<div class="text-gray-400 text-xs italic">Set when approving</div>`;

    document.getElementById('modalContent').innerHTML = `
      <div class="grid grid-cols-2 gap-3 text-sm">
        <div class="text-gray-500">Sender:</div><div class="font-medium">${app.sender_name}</div>
        <div class="text-gray-500">Email:</div><div class="font-medium">${app.sender_email}</div>
        <div class="text-gray-500">Subject:</div><div class="font-medium">${app.sender_subject}</div>
        <div class="text-gray-500">Application:</div><div>${statusLabels[app.status] || app.status}</div>
        <div class="text-gray-500">Payment:</div><div>${paymentLabels[app.payment_status] || app.payment_status}</div>
        <div class="text-gray-500">Amount Set:</div>${amountHtml}
      </div>
      <div class="mt-4">
        <div class="text-gray-500 text-sm mb-1 font-medium">Message / Description:</div>
        <div class="p-3 bg-gray-50 rounded text-sm border italic">"${app.sender_mssg}"</div>
      </div>
      ${proofHtml}
    `;

    document.getElementById('appModal').classList.remove('hidden');

    if (app.status === 'pending') {
      // Show amount input + approve/reject buttons
      document.getElementById('amountInputSection').classList.remove('hidden');
      document.getElementById('approveBtn').classList.remove('hidden');
      document.getElementById('rejectBtn').classList.remove('hidden');
      document.getElementById('approveBtn').onclick = () => approveAppointment(appId);
      document.getElementById('rejectBtn').onclick = () => rejectAppointment(appId);
    } else if (app.status === 'approved' && app.payment_status === 'submitted') {
      document.getElementById('confirmPaymentBtn').classList.remove('hidden');
      document.getElementById('confirmPaymentBtn').onclick = () => confirmPayment(appId);
    }

    document.getElementById('deleteBtn').onclick = () => deleteAppointment(appId);
  }

  function closeModal() {
    document.getElementById('appModal').classList.add('hidden');
    currentAppId = null;
  }

  async function approveAppointment(id) {
    const amount = parseFloat(document.getElementById('approvalAmountInput').value);
    if (!amount || amount <= 0) {
      alert('Please enter a valid payment amount before approving.');
      return;
    }
    if (!confirm(`Approve this application with a payment amount of $${amount.toLocaleString()}? An approval email will be sent to the user.`)) return;

    try {
      const res = await fetch(`/admin/appointment/${id}/approve`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ amount }),
      });
      const data = await res.json();
      alert(data.message || 'Application approved. Email sent to user.');
      location.reload();
    } catch (err) {
      alert('Error approving appointment');
    }
  }

  async function rejectAppointment(id) {
    if (!confirm('Reject this application?')) return;
    try {
      const res = await fetch(`/admin/appointment/${id}/reject`, { method: 'POST' });
      const data = await res.json();
      alert(data.message || 'Application rejected.');
      location.reload();
    } catch (err) {
      alert('Error rejecting appointment');
    }
  }

  async function confirmPayment(id) {
    if (!confirm('Confirm this payment? The appointment will be marked as fully confirmed.')) return;
    try {
      const res = await fetch(`/admin/appointment/${id}/confirm-payment`, { method: 'POST' });
      const data = await res.json();
      alert(data.message || 'Payment confirmed!');
      location.reload();
    } catch (err) {
      alert('Error confirming payment');
    }
  }

  async function deleteAppointment(id) {
    if (!confirm('Permanently delete this record?')) return;
    try {
      const res = await fetch(`/admin/appointment/${id}`, { method: 'DELETE' });
      const data = await res.json();
      alert(data.mssg || 'Record deleted');
      location.reload();
    } catch (err) {
      alert('Error deleting appointment');
    }
  }
</script>

</body>
</html>