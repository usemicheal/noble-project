<%- include('../partials/header', { title: 'QPhone Orders - Admin Dashboard' }) %>
<%- include('../partials/nav', { page: 'qphone' }) %>
<%- include('../partials/toast') %>

<div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-gray-100">
                <tr>
                    <th class="px-4 py-3 text-left text-sm font-medium">Full Name</th>
                    <th class="px-4 py-3 text-left text-sm font-medium">Email</th>
                    <th class="px-4 py-3 text-left text-sm font-medium">Phone</th>
                    <th class="px-4 py-3 text-left text-sm font-medium">Coin</th>
                    <th class="px-4 py-3 text-left text-sm font-medium">Amount</th>
                    <th class="px-4 py-3 text-left text-sm font-medium">Date</th>
                    <th class="px-4 py-3 text-left text-sm font-medium">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                <% if (orders.length === 0) { %>
                <tr>
                    <td colspan="7" class="px-4 py-6 text-center text-gray-400 text-sm">No QPhone orders yet.</td>
                </tr>
                <% } %>
                <% orders.forEach(order => { %>
                <tr>
                    <td class="px-4 py-3 text-sm"><%= order.fullname || 'N/A' %></td>
                    <td class="px-4 py-3 text-sm"><%= order.email || 'N/A' %></td>
                    <td class="px-4 py-3 text-sm"><%= order.phone || 'N/A' %></td>
                    <td class="px-4 py-3 text-sm"><%= order.wallet_address || 'N/A' %></td>
                    <td class="px-4 py-3 text-sm">$<%= order.amount || 0 %></td>
                    <td class="px-4 py-3 text-sm"><%= new Date(order.createdAt).toLocaleDateString() %></td>
                    <td class="px-4 py-3 text-sm">
                        <button onclick="showOrderModal('<%= order._id %>')" class="text-black hover:underline">View</button>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<!-- ORDER DETAIL MODAL -->
<div id="orderModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50">
    <div class="bg-white rounded-lg max-w-2xl w-full max-h-screen overflow-y-auto">
        <div class="p-6">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-bold">QPhone Order Details</h2>
                <button onclick="closeModal()" class="text-2xl">&times;</button>
            </div>
            <div id="orderModalContent" class="space-y-3 text-sm"></div>
            <div class="flex gap-3 mt-6">
                <button id="deleteOrderBtn"
                        class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700">
                    Delete Order
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    const orders = <%- JSON.stringify(orders) %>;
    let currentOrderId = null;

    function showOrderModal(orderId) {
        const order = orders.find(o => o._id === orderId);
        if (!order) return;

        currentOrderId = orderId;

        const content = `
            <div><strong>Full Name:</strong> ${order.fullname || 'N/A'}</div>
            <div><strong>Email:</strong> ${order.email || 'N/A'}</div>
            <div><strong>Phone:</strong> ${order.phone || 'N/A'}</div>
            <div><strong>Delivery Address:</strong> ${order.address || 'N/A'}</div>
            <div><strong>Payment Coin / Wallet Address:</strong> ${order.wallet_address || 'N/A'}</div>
            <div><strong>Amount:</strong> $${order.amount || 0}</div>
            <div><strong>Date:</strong> ${new Date(order.createdAt).toLocaleString()}</div>
            <hr class="my-3">
            <div><strong>Proof of Payment:</strong></div>
            ${order.proof_of_payment
                ? `<img src="${order.proof_of_payment}" class="w-full rounded mt-2" alt="Proof of Payment">`
                : '<p class="text-gray-400 mt-1">No image uploaded</p>'
            }
        `;

        document.getElementById('orderModalContent').innerHTML = content;
        document.getElementById('orderModal').classList.remove('hidden');
        document.getElementById('deleteOrderBtn').onclick = () => deleteOrder(orderId);
    }

    function closeModal() {
        document.getElementById('orderModal').classList.add('hidden');
    }

    async function deleteOrder(orderId) {
        if (!confirm('Are you sure you want to delete this QPhone order?')) return;

        try {
            const res = await fetch(`/admin/qphone/${orderId}`, { method: 'DELETE' });
            const data = await res.json();

            if (res.ok) {
                alert(data.message || 'Order deleted successfully');
                location.reload();
            } else {
                alert('Error: ' + (data.message || 'Failed to delete'));
            }
        } catch (err) {
            console.error('Delete order error:', err);
            alert('An unexpected error occurred.');
        }
    }
</script>

</body>
</html>